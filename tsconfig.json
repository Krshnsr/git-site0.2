
{
  "compilerOptions": {
    /* 1. टारगेट और लाइब्रेरी (Browser Environment) */
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "node",

    /* 2. आउटपुट सेटिंग्स */
    "outDir": "./",                    /* कंपाइल हुई JS फाइल को उसी रूट या dist में भेजने के लिए */
    "sourceMap": true,                 /* ब्राउज़र में डीबगिंग आसान करने के लिए */
    "removeComments": false,           /* जरूरी कमेंट्स बनाए रखने के लिए */

    /* 3. सख्त टाइप-चेकिंग (Strictness) */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    /* 4. कोड क्वालिटी और अनयूज़्ड कोड चेक्स */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* 5. इंटरऑपरेबिलिटी और सेफ्टी */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "app.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}